{
  "info": {
    "name": "Black_list",
    "description": "Pruebas de integración del servicio blacklist_email. Generada desde las capacidades del repositorio; importable en Postman. Ejecutar completa en orden sobre una base de pruebas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearer_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:5001",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "integration-test-token",
      "type": "string"
    },
    {
      "key": "app_uuid",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Salud sin autenticación",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/blacklists/ping",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"test_email\", `newman-${runId}@example.com`);",
              "pm.collectionVariables.set(\"optional_email\", `optional-${runId}@example.com`);",
              "pm.collectionVariables.set(\"null_email\", `null-${runId}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
              "const blacklistResponse = pm.response.json();",
              "pm.test(\"Servicio disponible\", () => { pm.expect(blacklistResponse.message).to.eql(\"pong\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Consultar correo no registrado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/blacklists/{{test_email}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
              "const blacklistResponse = pm.response.json();",
              "pm.test(\"Correo fuera de blacklist\", () => { pm.expect(blacklistResponse.is_blacklisted).to.eql(false); pm.expect(blacklistResponse.blocked_reason).to.eql(null); pm.expect(blacklistResponse.email).to.eql(pm.collectionVariables.get(\"test_email\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Registrar correo con motivo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/blacklists",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{test_email}}\", \"app_uuid\": \"{{app_uuid}}\", \"blocked_reason\": \"Prueba de integración Newman\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
              "const blacklistResponse = pm.response.json();",
              "pm.test(\"Registro creado\", () => { pm.expect(blacklistResponse.email).to.eql(pm.collectionVariables.get(\"test_email\")); pm.expect(blacklistResponse.id).to.match(/^[0-9a-f-]{36}$/i); pm.expect(Number.isNaN(Date.parse(blacklistResponse.created_at))).to.eql(false); });"
            ]
          }
        }
      ]
    },
