              "pm.test(\"Registro persistido con motivo\", () => { pm.expect(blacklistResponse.is_blacklisted).to.eql(true); pm.expect(blacklistResponse.email).to.eql(pm.collectionVariables.get(\"test_email\")); pm.expect(blacklistResponse.blocked_reason).to.eql(\"Prueba de integración Newman\"); });"
            ]
          }
        }
      ]
